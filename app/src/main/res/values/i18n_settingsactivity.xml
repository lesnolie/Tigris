    <string name="i18n_settingsactivity_005" formatted="false">Apps, casting &amp; updates</string>
    <string name="i18n_settingsactivity_006" formatted="false">Update Tigris, or install MiracastReceiver casting and HGTV short dramas on demand. No bundled APKs.</string>
    <string name="i18n_settingsactivity_007" formatted="false">Open</string>
    <string name="i18n_settingsactivity_008" formatted="false">Appearance</string>
    <string name="i18n_settingsactivity_009" formatted="false">Time format</string>
    <string name="i18n_settingsactivity_010" formatted="false">Whether the clock on the home screen and in Control Center uses 12-hour (11:49 AM) or 24-hour (23:49) time.</string>
    <string name="i18n_settingsactivity_011" formatted="false">24-hour</string>
    <string name="i18n_settingsactivity_012" formatted="false">12-hour</string>
    <string name="i18n_settingsactivity_013" formatted="false">Clock position</string>
    <string name="i18n_settingsactivity_014" formatted="false">A small clock in the top-right corner, a large clock with the date in the top-left (the earlier style), or no clock at all.</string>

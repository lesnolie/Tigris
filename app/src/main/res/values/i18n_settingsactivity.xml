    <string name="i18n_settingsactivity_016" formatted="false">Don\'t show</string>
    <string name="i18n_settingsactivity_017" formatted="false">Top right</string>
    <string name="i18n_settingsactivity_018" formatted="false">Settings background</string>
    <string name="i18n_settingsactivity_019" formatted="false">Use your uploaded image as the settings background, or a plain dark background.</string>
    <string name="i18n_settingsactivity_020" formatted="false">Image</string>
    <string name="i18n_settingsactivity_021" formatted="false">Plain</string>
    <string name="i18n_settingsactivity_022" formatted="false">Settings icon</string>
    <string name="i18n_settingsactivity_023" formatted="false">The icon for this entry: your own uploaded image, or the built-in gear.</string>
    <string name="i18n_settingsactivity_024" formatted="false">Uploaded image</string>
    <string name="i18n_settingsactivity_025" formatted="false">Gear</string>
    <string name="i18n_settingsactivity_026" formatted="false">Upload avatar</string>
    <string name="i18n_settingsactivity_027" formatted="false">Scan the QR code with your phone, upload a photo under “Avatar” on the web page, then return to the home screen.</string>
    <string name="i18n_settingsactivity_028" formatted="false">Upload from phone</string>
    <string name="i18n_settingsactivity_029" formatted="false">Show avatar in the top-right corner</string>
    <string name="i18n_settingsactivity_030" formatted="false">Press the avatar in the top-right corner to open Home Screen Settings.</string>
    <string name="i18n_settingsactivity_031" formatted="false">Focus animation</string>
    <string name="i18n_settingsactivity_032" formatted="false">tvOS: the selected app grows, tilts with the direction and catches a highlight. Simple: it only grows.</string>
    <string name="i18n_settingsactivity_033" formatted="false">\n“Auto” uses Simple on lower-end TVs.</string>
    <string name="i18n_settingsactivity_034" formatted="false">Simple</string>
    <string name="i18n_settingsactivity_035" formatted="false">Control Center style</string>
    <string name="i18n_settingsactivity_036" formatted="false">Glass: frosted glass that shows the image behind, and the selected button lights up its neighbours. Panel: the earlier dark panel, easier on performance.</string>
    <string name="i18n_settingsactivity_037" formatted="false">\n“Auto” uses Panel on lower-end TVs.</string>
    <string name="i18n_settingsactivity_038" formatted="false">Glass</string>
    <string name="i18n_settingsactivity_039" formatted="false">Panel</string>
    <string name="i18n_settingsactivity_040" formatted="false">Boot animation</string>
    <string name="i18n_settingsactivity_041" formatted="false">Boot animation</string>
    <string name="i18n_settingsactivity_042" formatted="false">Plays the first time the home screen appears after boot; the logo zooms into the desktop at the end. Press any key to skip.</string>
    <string name="i18n_settingsactivity_043" formatted="false">\nDownload the default video or upload your own; otherwise the Tigris wordmark plays.</string>
    <string name="i18n_settingsactivity_044" formatted="false">On boot</string>
    <string name="i18n_settingsactivity_045" formatted="false">On boot and wake</string>
    <string name="i18n_settingsactivity_046" formatted="false">Off</string>
    <string name="i18n_settingsactivity_047" formatted="false">Animation content</string>
    <string name="i18n_settingsactivity_048" formatted="false">Uploaded video: for example Apple TV\'s boot animation, with the logo zooming in at the end. Tigris wordmark: the wordmark fades in and then zooms.</string>
    <string name="i18n_settingsactivity_049" formatted="false">\nWithout a downloaded or uploaded video, use the Tigris wordmark.</string>
    <string name="i18n_settingsactivity_050" formatted="false">Tigris wordmark</string>
    <string name="i18n_settingsactivity_051" formatted="false">Downloaded / uploaded video</string>
    <string name="i18n_settingsactivity_052" formatted="false">No video · Tigris wordmark</string>
    <string name="i18n_settingsactivity_053" formatted="false">Wait after wake</string>
    <string name="i18n_settingsactivity_054" formatted="false">When waking from standby, stay black for this long before playing the animation. Many TVs (especially OLED) take a few seconds to actually light up; increase it if you miss the start of the animation, decrease it if the black screen lasts too long.</string>

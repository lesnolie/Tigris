---
import { brand, assets } from "../data/site";
import type { Copy, Locale } from "../data/lang";
import { uiStrings } from "../data/strings";
import SiteSearch from "./SiteSearch.astro";

interface Props {
  copy: Copy;
  locale: Locale;
}

const { copy, locale } = Astro.props;
const t = uiStrings[locale];
const home = locale === "zh" ? "/" : "/en/";
---
<a class="skip-link" href="#main">{t.skip}</a>

<svg aria-hidden="true" class="sprite">
  <symbol id="i-download" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 3v12m0 0 4.5-4.5M12 15l-4.5-4.5"></path><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"></path>
  </symbol>
  <symbol id="i-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    <path d="M7 17 17 7M9 7h8v8"></path>
  </symbol>
  <symbol id="i-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="m4 12.5 5 5L20 6.5"></path>
  </symbol>
  <symbol id="i-info" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="9"></circle><path d="M12 11v6M12 7.5v.5"></path>
  </symbol>
  <symbol id="i-warning" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M10.3 4.2 2.6 18a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 4.2a2 2 0 0 0-3.4 0Z"></path><path d="M12 9v4.5M12 17v.5"></path>
  </symbol>
  <symbol id="i-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 0 1 2-2h10"></path>
  </symbol>
  <symbol id="i-terminal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="4" width="18" height="16" rx="2.5"></rect><path d="m7 9 3 3-3 3M13 15h4"></path>
  </symbol>
  <symbol id="i-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="m9 6 6 6-6 6"></path>
  </symbol>
  <symbol id="i-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
    <path d="m6 6 12 12M18 6 6 18"></path>
  </symbol>
  <symbol id="i-play" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="9"></circle><path d="M10.5 8.8v6.4l5-3.2z" fill="currentColor" stroke="none"></path>
  </symbol>
</svg>

<header class="site-header">
  <nav class="nav" aria-label={t.navLabel}>
    <a class="brand" href={home} aria-label={`${brand.name} home`}>
      <img src={assets.favicon} width="30" height="30" alt="" />
      <span>{brand.name} <em>{brand.tagline}</em></span>
    </a>
    <ul class="nav-links" id="nav-links">
      {copy.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      <li class="nav-mobile-cta">
        <a class="btn btn-primary" href={brand.apk} rel="noopener">{copy.menuCta}</a>
      </li>
      <li class="nav-mobile-note">{copy.menuNote}</li>
    </ul>
    <div class="nav-cta">
      <SiteSearch locale={locale} part="button" />
      <a class="nav-lang" href={copy.langSwitch.href} hreflang={copy.langSwitch.lang} lang={copy.langSwitch.lang}>{copy.langSwitch.label}</a>
      <a class="btn btn-primary btn-sm" href={brand.apk} rel="noopener">
        <svg aria-hidden="true"><use href="#i-download"></use></svg>
        {copy.headerCta}
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links" aria-label={t.menuLabel} data-label-open={t.menuLabel} data-label-close={t.menuCloseLabel}>
        <span></span>
      </button>
    </div>
  </nav>
  <SiteSearch locale={locale} part="dialog" />
</header>

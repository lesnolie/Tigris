---
import { brand, clips } from "../data/site";
import { uiStrings } from "../data/strings";
import type { Copy, Locale } from "../data/lang";

interface Props {
  copy: Copy;
  locale: Locale;
}

const { copy, locale } = Astro.props;
const hero = copy.hero;
const t = uiStrings[locale];
const keyword = locale === "zh" ? "惊艳" : "opening again";
const accentLine = hero.titleLines[1];
const keywordAt = accentLine.indexOf(keyword);
const accentBefore = keywordAt >= 0 ? accentLine.slice(0, keywordAt) : accentLine;
const accentAfter = keywordAt >= 0 ? accentLine.slice(keywordAt + keyword.length) : "";
---
<section class="hero">
  <div class="hero-aurora" aria-hidden="true">
    <span class="aurora-blob blob-a"></span>
    <span class="aurora-blob blob-b"></span>
    <span class="aurora-blob blob-c"></span>
  </div>

  <div class="wrap hero-center">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1>
      <span class="line"><span class="line-inner">{hero.titleLines[0]}</span></span>
      <span class="line"><span class="line-inner">{accentBefore}{keywordAt >= 0 && <span class="keyword" data-sheen={keyword}>{keyword}</span>}{accentAfter}</span></span>
    </h1>
    <p class="hero-sub">{hero.sub}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={brand.apk} rel="noopener">
        <svg aria-hidden="true"><use href="#i-download"></use></svg>
        {hero.primary}
      </a>
      <a class="btn btn-ghost" href="#install">
        {hero.secondary}
        <svg aria-hidden="true"><use href="#i-arrow"></use></svg>
      </a>
    </div>
    <ul class="hero-meta">
      <li class="chip"><span class="dot"></span>{hero.chips[0]}</li>
      {hero.chips.slice(1).map((chip) => <li class="chip">{chip}</li>)}
    </ul>
  </div>

  <div class="wrap hero-stage">
    <div class="tv-stage">
      <div class="tv-glow" aria-hidden="true"></div>
      <div class="tv-perspective">
        <div class="tv-scroll">
          <div class="tv-scene">
            <div class="tv-tilt" data-tv-tilt>
              <div class="tv-frame">
                <div class="tv-screen">
                  <video
                    data-clip
                    src={clips.home.src}
                    poster={clips.home.poster}
                    width="1280"
                    height="720"
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    aria-label={hero.imageAlt}
                  ></video>
                  <button class="clip-toggle" type="button" data-clip-toggle aria-pressed="false"
                    aria-label={t.pauseClips} data-label-pause={t.pauseClips} data-label-play={t.playClips}>
                    <svg viewBox="0 0 16 16" aria-hidden="true"><rect class="i-pause" x="4" y="3" width="3" height="10" rx="1"/><rect class="i-pause" x="9" y="3" width="3" height="10" rx="1"/><path class="i-play" d="M5 3.2v9.6a.6.6 0 0 0 .9.5l7.6-4.8a.6.6 0 0 0 0-1L5.9 2.7a.6.6 0 0 0-.9.5z"/></svg>
                  </button>
                </div>
                <div class="tv-glare" aria-hidden="true"></div>
              </div>
              <div class="float-chip chip-shelf" aria-hidden="true">
                <div class="chip-body">
                  <canvas class="chip-glass" width="2" height="2" aria-hidden="true"></canvas>
                  <span class="glyph"><svg><use href="#i-play"></use></svg></span>
                  <span class="chip-copy"><strong>{hero.floating[1].title}</strong><small>{hero.floating[1].sub}</small></span>
                </div>
              </div>
              <div class="float-chip chip-dock" aria-hidden="true">
                <div class="chip-body">
                  <canvas class="chip-glass" width="2" height="2" aria-hidden="true"></canvas>
                  <span class="glyph"><svg><use href="#i-check"></use></svg></span>
                  <span class="chip-copy"><strong>{hero.floating[0].title}</strong><small>{hero.floating[0].sub}</small></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <p class="tv-caption">
      <span class="live">{locale === "zh" ? "实拍录屏" : "Real recording"} · Sony BRAVIA XR-55A80J · Android TV 12</span>
      <span>1280 × 720</span>
    </p>
    <p class="hero-note">{hero.note}</p>
  </div>
</section>

<div class="proof">
  <div class="wrap proof-inner">
    {copy.proof.map((item) => (
      <span class="proof-item"><svg aria-hidden="true"><use href="#i-check"></use></svg>{item}</span>
    ))}
  </div>
</div>

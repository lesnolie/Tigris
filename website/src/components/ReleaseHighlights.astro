---
import type { Locale } from "../data/lang";
import { brand } from "../data/site";
interface Props { locale: Locale }
const zh = Astro.props.locale === "zh";
const items = zh ? [
  ["01", "App 图标更清晰，比例更协调。", "原生 TV 横幅优先，方形图标不再放大模糊当作背景。"],
  ["02", "极致液态玻璃，按需开启。", "静态壁纸有细腻折射，动态视频下 Dock 与控制中心可透明显示。默认关闭。"],
  ["03", "屏保尊重播放与投屏状态。", "改善系统休眠前的计时、暂停视频识别及更新安装恢复。"],
] : [
  ["01", "Sharper, better-proportioned app tiles.", "Preserve TV banners and use crisp native icons rather than blurred, enlarged duplicates."],
  ["02", "Extreme Liquid Glass, on your terms.", "Refined glass on still wallpapers; transparent video Dock and Control Center. Off by default."],
  ["03", "Photo frame respects playback and casting.", "Better system idle timing, paused-video handling and safer update recovery."],
];
---
<section class="release-strip wrap" aria-label={zh ? "本次更新" : "Latest update"}>
  <a class="release-pill" href={brand.releases}><span class="dot"></span>{zh ? "全部版本" : "All releases"} ↗</a>
  <div class="release-grid">{items.map(([n,title,body]) => <article><span class="release-number">{n}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
</section>

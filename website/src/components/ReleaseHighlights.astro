---
import type { Locale } from "../data/lang";
import { brand } from "../data/site";
interface Props { locale: Locale }
const zh = Astro.props.locale === "zh";
const items = zh ? [
  ["01", "动态壁纸下，Dock 跟手不再滞后。", "提高视频取样频率并缩短玻璃贴图处理时间，让动态画面及时透过 Dock，同时保留液态玻璃质感。"],
  ["02", "软件更新进度清晰可见。", "显示下载百分比，并可恢复系统安装确认；遇到卡住的任务可取消后重试。"],
  ["03", "更新选项在自己的区域滚动。", "右侧列表在标题下方独立滚动，页面其他内容保持稳定，避免遮挡和裁切。"],
] : [
  ["01", "A more responsive Dock over live wallpaper.", "More frequent video sampling and faster glass updates help moving scenes show through the Dock with less visible lag."],
  ["02", "Clear software update progress.", "See download percentage, reopen the system install confirmation, or cancel a stuck task and retry."],
  ["03", "Update options scroll in their own panel.", "The right-hand list stays below its title while the rest of the page remains steady, avoiding overlap and clipping."],
];
---
<section class="release-strip wrap" aria-label={zh ? "本次更新" : "Latest update"}>
  <a class="release-pill" href={brand.releases}><span class="dot"></span>{zh ? "全部版本" : "All releases"} ↗</a>
  <div class="release-grid">{items.map(([n,title,body]) => <article><span class="release-number">{n}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
</section>

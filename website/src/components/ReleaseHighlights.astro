---
import type { Locale } from "../data/lang";
import { brand } from "../data/site";
interface Props { locale: Locale }
const zh = Astro.props.locale === "zh";
const items = zh ? [
  ["01", "玻璃与背景，同步变化。", "进入设置、更换壁纸、切换顶部内容预览时，极致液态玻璃与背景同帧切换、同步淡入。"],
  ["02", "设置更快打开，滚动更轻快。", "提前准备设置页画面，减少滚动时的绘制开销。极致液态玻璃仍默认关闭，可按需开启。"],
  ["03", "相框等待时间，统一设置。", "确认 Tigris 成为电视主屏幕并完成授权后，系统屏保沿用相框计时；播放与投屏继续避让，关闭时可还原。"],
] : [
  ["01", "Glass and backdrop move together.", "Opening Settings, changing wallpapers and switching Top Shelf now apply Extreme Liquid Glass and the backdrop in the same frame, with matching fades."],
  ["02", "Faster Settings, lighter scrolling.", "Settings prepares its backdrop ahead of time and scrolling takes less drawing work. Extreme Liquid Glass remains optional and off by default."],
  ["03", "One photo-frame delay.", "Once Tigris is confirmed as the TV's Home screen and permissions are granted, the system screensaver follows its timer. Playback and casting stay protected; opting out attempts to restore settings."],
];
---
<section class="release-strip wrap" aria-label={zh ? "本次更新" : "Latest update"}>
  <a class="release-pill" href={brand.releases}><span class="dot"></span>{zh ? "全部版本" : "All releases"} ↗</a>
  <div class="release-grid">{items.map(([n,title,body]) => <article><span class="release-number">{n}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
</section>

---
import type { Locale } from "../data/lang";
import { brand } from "../data/site";
interface Props { locale: Locale }
const zh = Astro.props.locale === "zh";
const items = zh ? [
  ["01", "设置分组，一眼找到。", "主屏幕设置首页只列分组：主屏幕、外观、壁纸、屏保、应用、系统……每组一页短列表，返回时回到原来那一行。设置项一个不少。"],
  ["02", "一块会发光的时钟。", "屏保新增时钟：霓虹、翻页、液晶、极简，多种配色，可显示秒、加飘雪或星光。霓虹亮起有“滋”的电流声，秒针声音可开关。左右换样式，上下换颜色。"],
  ["03", "图标，换成你喜欢的。", "长按 App 选择「更换图标」，用手机扫码上传图片：横版铺满，方形居中。随时恢复默认。"],
] : [
  ["01", "Settings, grouped.", "The Home Screen Settings page now lists groups — Home Screen, Appearance, Wallpaper, Screen Saver, Apps, System and more. Each is a short page, and you return to the row you came from. Nothing removed."],
  ["02", "A clock that glows.", "The screen saver gains a clock: Neon, Flip, LCD and Minimal in several colours, with optional seconds, snow or stars. Neon tubes buzz as they light; seconds can tick. Left/Right for style, Up/Down for colour."],
  ["03", "Icons, your way.", "Long press an app, choose Change icon and upload a picture from your phone: wide pictures fill the tile, square ones are centred. Restore any time."],
];
---
<section class="release-strip wrap" aria-label={zh ? "本次更新" : "Latest update"}>
  <a class="release-pill" href={brand.releases}><span class="dot"></span>{zh ? "v2.0.28 · 正式版更新" : "v2.0.28 · Stable release"} ↗</a>
  <div class="release-grid">{items.map(([n,title,body]) => <article><span class="release-number">{n}</span><h3>{title}</h3><p>{body}</p></article>)}</div>
  <figure class="release-capture">
    <img src="/img/release-clock.webp" width="1600" height="900" loading="lazy" alt={zh ? "霓虹时钟屏保：粉色小时与青色分钟灯管，下方有倒影" : "Neon clock screen saver: pink hour and cyan minute tubes with a reflection below"} />
    <figcaption>{zh ? "Sony BRAVIA 实机截图 · 霓虹时钟屏保（本地签名测试构建）" : "Captured on a Sony BRAVIA with a locally signed test build: the neon clock screen saver."}</figcaption>
  </figure>
</section>
<style>
  .release-capture { margin: 28px 0 0; }
  .release-capture img { display: block; width: 100%; height: auto; border-radius: 20px; }
  .release-capture figcaption { margin-top: 12px; color: var(--muted); font-size: 13px; line-height: 1.6; }
</style>

---
import type { Locale } from "../data/lang";
import registry from "../../../tools/installation_strategies.json";
interface Props { locale: Locale }
const { locale } = Astro.props;
const zh = locale === "zh";
---
<div class="strategy-guide">
  <h3>{zh ? "策略对照" : "Strategy lookup"}</h3>
  <p>{zh ? "上面那条命令会读取电视的真实型号，再对照这张表。这不是另一套安装步骤。" : "The command above reads the TV and matches this table. It is not a second way to install."}</p>
  <div class="table-wrap"><table>
    <thead><tr><th>{zh ? "策略" : "Strategy"}</th><th>{zh ? "实际路径" : "Actual path"}</th></tr></thead>
    <tbody>{registry.strategies.map(s => <tr><th scope="row">{s.name[locale]}</th><td>{s.guidance[locale]}</td></tr>)}</tbody>
  </table></div>
</div>
